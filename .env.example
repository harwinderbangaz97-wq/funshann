# Firebase App Check Configuration
# Register your domains (e.g., custom domain, GitHub Pages, Blogger) in Google Cloud reCAPTCHA Enterprise or reCAPTCHA v3
# and link the site key in Firebase Console -> App Check -> Apps -> Web App.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_RECAPTCHA_V3_SITE_KEY=

# Local Development Only: Optional Firebase App Check debug token registered in Firebase Console -> App Check -> Manage debug tokens
# WARNING: NEVER set this in production environments.
VITE_APPCHECK_DEBUG_TOKEN=
